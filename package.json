{
  "name": "t3code-rtl",
  "version": "0.2.8",
  "description": "Right-to-left (RTL) support for T3 Code: patches the app so Persian (Farsi) and Arabic chat messages read right to left.",
  "keywords": [
    "rtl",
    "right-to-left",
    "bidi",
    "bidirectional-text",
    "persian",
    "farsi",
    "arabic",
    "unicode",
    "i18n",
    "localization",
    "t3code",
    "t3-code",
    "electron",
    "cli",
    "patch"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "t3code-rtl": "dist/cli.js"
  },
  "files": [
    "dist",
    "rtl.js",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhadeidi/t3code-rtl.git"
  },
  "bugs": {
    "url": "https://github.com/farhadeidi/t3code-rtl/issues"
  },
  "homepage": "https://github.com/farhadeidi/t3code-rtl#readme",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --platform node --target node20",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test:smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
